{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|.*navigate.*",
        "hooks": [
          {
            "type": "command",
            "command": "P=$(command -v python || command -v python3); \"$P\" \"${CLAUDE_PROJECT_DIR}/hooks/guard_hook.py\""
          }
        ]
      }
    ]
  }
}